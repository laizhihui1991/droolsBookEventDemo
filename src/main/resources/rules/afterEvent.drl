package rules;

import com.test.drools.pojo.operators.PaymentEvent;
import com.test.drools.pojo.operators.LogisticsEvent;

// 物流单必须在支付后 3分30秒~4分钟之间生成
rule "Logistics generated after payment within expected time"
when
    $p : PaymentEvent($orderId : orderId)
    $l : LogisticsEvent(orderId == $orderId, this after[3m30s, 4m] $p)
then
    System.out.println("订单[" + $orderId + "] 的物流单按时生成！");
    System.out.println("支付事件：" + $p);
    System.out.println("物流事件：" + $l);
end


// 检测支付是否在发货前 3m30s~4m 内完成
rule "Payment must occur 3m30s~4m before Logistics"
when
    $logistics : LogisticsEvent($oid : orderId)
    $payment   : PaymentEvent(orderId == $oid, this after[-4m, -3m30s] $logistics)
then
    System.out.println("[规则匹配] 订单 " + $oid + " 之前 3分30秒~4分钟之间，符合要求。");
end