package rules

import com.test.drools.pojo.TransactionEvent;


rule "检测事件是否重叠"
when
    $e1 : TransactionEvent()
    $e2 : TransactionEvent(
              this != $e1,
              // 区间重叠
              this overlaps $e1
          )
then
    System.out.println("区间重叠：事件 " + $e1.getTransactionId() + " 与事件 " + $e2.getTransactionId() + " 在时间上有交集！");
end


